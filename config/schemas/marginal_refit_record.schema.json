{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fe5110/marginal_refit_record.schema.json",
  "title": "FE5110 monthly marginal refit record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "refit_id",
    "refit_date",
    "year",
    "month",
    "universe_variant",
    "grouping_id",
    "group_id",
    "group_size",
    "portfolio_weight",
    "requested_training_start",
    "first_training_date",
    "last_training_date",
    "training_observations",
    "evaluation_observations",
    "selected_method",
    "fallback_level",
    "fallback_used",
    "ewma_used",
    "mean_constant_scaled",
    "phi",
    "omega_scaled",
    "alpha",
    "beta",
    "student_t_df",
    "first_forecast_variance_scaled",
    "convergence_flag",
    "loglikelihood",
    "aic",
    "bic",
    "attempt_count",
    "attempt_log_json",
    "fit_status"
  ],
  "properties": {
    "refit_id": {"type": "string", "minLength": 1},
    "refit_date": {"type": "string", "format": "date"},
    "year": {"type": "integer", "minimum": 2020, "maximum": 2025},
    "month": {"type": "integer", "minimum": 1, "maximum": 12},
    "universe_variant": {"enum": ["security_primary", "issuer_deduplicated_robustness"]},
    "grouping_id": {"enum": ["gics_sector", "hierarchical_cluster"]},
    "group_id": {"type": "string", "minLength": 1},
    "group_size": {"type": "integer", "minimum": 1},
    "portfolio_weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "requested_training_start": {"type": "string", "format": "date"},
    "first_training_date": {"type": "string", "format": "date"},
    "last_training_date": {"type": "string", "format": "date"},
    "training_observations": {"type": "integer", "minimum": 700},
    "evaluation_observations": {"type": "integer", "minimum": 1},
    "selected_method": {
      "enum": ["ar_garch_t", "ar_garch_t_retry", "constant_mean_garch_t", "ewma_empirical"]
    },
    "fallback_level": {"type": "integer", "minimum": 0, "maximum": 3},
    "fallback_used": {"type": "boolean"},
    "ewma_used": {"type": "boolean"},
    "mean_constant_scaled": {"type": "number"},
    "phi": {"type": "number"},
    "omega_scaled": {"type": "number"},
    "alpha": {"type": "number"},
    "beta": {"type": "number"},
    "student_t_df": {"type": ["number", "null"]},
    "first_forecast_variance_scaled": {"type": "number", "exclusiveMinimum": 0},
    "convergence_flag": {"type": ["integer", "null"]},
    "loglikelihood": {"type": ["number", "null"]},
    "aic": {"type": ["number", "null"]},
    "bic": {"type": ["number", "null"]},
    "attempt_count": {"type": "integer", "minimum": 1, "maximum": 4},
    "attempt_log_json": {"type": "string", "minLength": 2},
    "fit_status": {"enum": ["ok", "fallback"]}
  }
}
