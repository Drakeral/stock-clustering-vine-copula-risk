{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fe5110/vine_copula_refit_record.schema.json",
  "title": "FE5110 monthly vine copula refit record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vine_refit_id",
    "source_copula_refit_id",
    "matched_gaussian_refit_id",
    "refit_date",
    "year",
    "month",
    "universe_variant",
    "model_id",
    "grouping_id",
    "training_start",
    "training_end",
    "training_observations",
    "dimension",
    "truncation_level",
    "group_order_json",
    "structure_matrix_json",
    "vine_model_json",
    "pair_count",
    "failed_pair_count",
    "failed_pair_fraction",
    "failed_pairs_json",
    "family_counts_json",
    "rotation_counts_json",
    "number_parameters",
    "loglikelihood",
    "aic",
    "bic",
    "library",
    "library_version",
    "fit_seed_components",
    "base_uniform_sha256",
    "whole_vine_fallback",
    "fallback_reason",
    "fit_status"
  ],
  "properties": {
    "vine_refit_id": {"type": "string", "minLength": 1},
    "source_copula_refit_id": {"type": "string", "minLength": 1},
    "matched_gaussian_refit_id": {"type": "string", "minLength": 1},
    "refit_date": {"type": "string", "format": "date"},
    "year": {"type": "integer", "minimum": 2020, "maximum": 2025},
    "month": {"type": "integer", "minimum": 1, "maximum": 12},
    "universe_variant": {"enum": ["security_primary", "issuer_deduplicated_robustness"]},
    "model_id": {"enum": ["M2", "M4"]},
    "grouping_id": {"enum": ["gics", "hierarchical"]},
    "training_start": {"type": "string", "format": "date"},
    "training_end": {"type": "string", "format": "date"},
    "training_observations": {"type": "integer", "minimum": 3},
    "dimension": {"type": "integer", "minimum": 2},
    "truncation_level": {"type": "integer", "minimum": 1},
    "group_order_json": {"type": "string", "minLength": 2},
    "structure_matrix_json": {"type": ["string", "null"]},
    "vine_model_json": {"type": ["string", "null"]},
    "pair_count": {"type": "integer", "minimum": 1},
    "failed_pair_count": {"type": "integer", "minimum": 0},
    "failed_pair_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "failed_pairs_json": {"type": "string", "minLength": 2},
    "family_counts_json": {"type": "string", "minLength": 2},
    "rotation_counts_json": {"type": "string", "minLength": 2},
    "number_parameters": {"type": ["number", "null"]},
    "loglikelihood": {"type": ["number", "null"]},
    "aic": {"type": ["number", "null"]},
    "bic": {"type": ["number", "null"]},
    "library": {"const": "pyvinecopulib"},
    "library_version": {"type": "string", "minLength": 1},
    "fit_seed_components": {
      "type": "array",
      "prefixItems": [
        {"const": 5110},
        {"type": "integer", "minimum": 2020, "maximum": 2025},
        {"type": "integer", "minimum": 1, "maximum": 12}
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "base_uniform_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "whole_vine_fallback": {"type": "boolean"},
    "fallback_reason": {"type": ["string", "null"]},
    "fit_status": {"enum": ["ok", "pair_fallback", "gaussian_fallback"]}
  }
}
