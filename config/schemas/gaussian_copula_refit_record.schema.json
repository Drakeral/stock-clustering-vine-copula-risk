{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fe5110/gaussian_copula_refit_record.schema.json",
  "title": "FE5110 monthly Gaussian copula refit record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "copula_refit_id",
    "refit_date",
    "year",
    "month",
    "universe_variant",
    "model_id",
    "grouping_id",
    "training_start",
    "training_end",
    "training_observations",
    "dimension",
    "group_order_json",
    "estimator",
    "correlation_matrix_json",
    "raw_min_eigenvalue",
    "repaired_min_eigenvalue",
    "maximum_absolute_adjustment",
    "condition_number",
    "log_determinant",
    "correlation_repaired",
    "factorization",
    "seed_components",
    "base_uniform_sha256",
    "fit_status"
  ],
  "properties": {
    "copula_refit_id": {"type": "string", "minLength": 1},
    "refit_date": {"type": "string", "format": "date"},
    "year": {"type": "integer", "minimum": 2020, "maximum": 2025},
    "month": {"type": "integer", "minimum": 1, "maximum": 12},
    "universe_variant": {"const": "security_primary"},
    "model_id": {"enum": ["M1", "M3"]},
    "grouping_id": {"enum": ["gics", "hierarchical"]},
    "training_start": {"type": "string", "format": "date"},
    "training_end": {"type": "string", "format": "date"},
    "training_observations": {"type": "integer", "minimum": 700},
    "dimension": {"const": 11},
    "group_order_json": {"type": "string", "minLength": 2},
    "estimator": {"const": "pearson_correlation_of_normal_scores"},
    "correlation_matrix_json": {"type": "string", "minLength": 2},
    "raw_min_eigenvalue": {"type": "number"},
    "repaired_min_eigenvalue": {"type": "number", "exclusiveMinimum": 0},
    "maximum_absolute_adjustment": {"type": "number", "minimum": 0},
    "condition_number": {"type": "number", "minimum": 1},
    "log_determinant": {"type": "number"},
    "correlation_repaired": {"type": "boolean"},
    "factorization": {"const": "cholesky"},
    "seed_components": {
      "type": "array",
      "prefixItems": [
        {"const": 5110},
        {"type": "integer", "minimum": 2020, "maximum": 2025},
        {"type": "integer", "minimum": 1, "maximum": 12}
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "base_uniform_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fit_status": {"enum": ["ok", "repaired"]}
  }
}
