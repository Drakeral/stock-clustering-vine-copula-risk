{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fe5110/full_vine_robustness_daily_record.schema.json",
  "title": "FE5110 daily full-vine robustness evaluation record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "year",
    "variant_id",
    "model_id",
    "grouping_id",
    "truncation_level",
    "realised_loss",
    "var_95",
    "var_975",
    "var_99",
    "es_975",
    "quantile_loss_95",
    "quantile_loss_99",
    "fz0_975",
    "exception_95",
    "exception_975",
    "exception_99",
    "copula_log_score",
    "forecast_status",
    "margin_fallback_count",
    "whole_vine_fallback"
  ],
  "properties": {
    "date": {"type": "string", "format": "date"},
    "year": {"type": "integer", "minimum": 2020, "maximum": 2025},
    "variant_id": {"enum": ["M2_t3", "M2_t10", "M4_t3", "M4_t10"]},
    "model_id": {"enum": ["M2", "M4"]},
    "grouping_id": {"enum": ["gics", "hierarchical"]},
    "truncation_level": {"enum": [3, 10]},
    "realised_loss": {"type": "number"},
    "var_95": {"type": "number"},
    "var_975": {"type": "number"},
    "var_99": {"type": "number"},
    "es_975": {"type": "number"},
    "quantile_loss_95": {"type": "number", "minimum": 0},
    "quantile_loss_99": {"type": "number", "minimum": 0},
    "fz0_975": {"type": "number"},
    "exception_95": {"type": "boolean"},
    "exception_975": {"type": "boolean"},
    "exception_99": {"type": "boolean"},
    "copula_log_score": {"type": "number"},
    "forecast_status": {"enum": ["ok", "fallback"]},
    "margin_fallback_count": {"type": "integer", "minimum": 0},
    "whole_vine_fallback": {"type": "boolean"}
  }
}
