{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fe5110/forecast_record.schema.json",
  "title": "FE5110 one-day risk forecast record",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"model_id": {"enum": ["M0", "M0_CC", "B_GICS_HS", "B_HIER_HS"]}},
        "required": ["model_id"]
      },
      "then": {
        "properties": {
          "seed_components": {"type": "null"},
          "margin_fallback_count": {"const": 0},
          "whole_vine_fallback": {"const": false},
          "copula_log_score": {"type": "null"},
          "forecast_status": {"const": "ok"}
        }
      },
      "else": {
        "properties": {
          "grouping_id": {"enum": ["gics", "hierarchical", "spectral", "pca_kmeans", "gics_balanced", "hierarchical_balanced"]},
          "seed_components": {
            "type": "array",
            "prefixItems": [
              {"const": 5110},
              {"type": "integer", "minimum": 2020, "maximum": 2025},
              {"type": "integer", "minimum": 1, "maximum": 12}
            ],
            "minItems": 3,
            "maxItems": 3
          },
          "copula_log_score": {"type": "number"}
        }
      }
    },
    {
      "if": {"properties": {"model_id": {"enum": ["M0", "M0_CC"]}}, "required": ["model_id"]},
      "then": {"properties": {"grouping_id": {"const": "none"}}}
    },
    {
      "if": {"properties": {"model_id": {"enum": ["M1", "M2"]}}, "required": ["model_id"]},
      "then": {"properties": {"grouping_id": {"const": "gics"}}}
    },
    {
      "if": {"properties": {"model_id": {"enum": ["M3", "M4"]}}, "required": ["model_id"]},
      "then": {"properties": {"grouping_id": {"const": "hierarchical"}}}
    },
    {
      "if": {"properties": {"model_id": {"enum": ["M5", "M6"]}}, "required": ["model_id"]},
      "then": {"properties": {"grouping_id": {"const": "spectral"}}}
    },
    {
      "if": {"properties": {"model_id": {"enum": ["M7", "M8"]}}, "required": ["model_id"]},
      "then": {"properties": {"grouping_id": {"const": "pca_kmeans"}}}
    },
    {
      "if": {"properties": {"model_id": {"const": "B_GICS_HS"}}, "required": ["model_id"]},
      "then": {"properties": {"grouping_id": {"const": "gics_balanced"}}}
    },
    {
      "if": {"properties": {"model_id": {"enum": ["B_GICS_GAUSSIAN", "B_GICS_VINE"]}}, "required": ["model_id"]},
      "then": {"properties": {"grouping_id": {"const": "gics_balanced"}}}
    },
    {
      "if": {"properties": {"model_id": {"const": "B_HIER_HS"}}, "required": ["model_id"]},
      "then": {"properties": {"grouping_id": {"const": "hierarchical_balanced"}}}
    },
    {
      "if": {"properties": {"model_id": {"enum": ["B_HIER_GAUSSIAN", "B_HIER_VINE"]}}, "required": ["model_id"]},
      "then": {"properties": {"grouping_id": {"const": "hierarchical_balanced"}}}
    }
  ],
  "required": [
    "date",
    "model_id",
    "grouping_id",
    "refit_id",
    "var_95",
    "var_975",
    "var_99",
    "es_975",
    "realised_simple_return",
    "realised_loss",
    "seed_components",
    "margin_fallback_count",
    "whole_vine_fallback",
    "copula_log_score",
    "forecast_status"
  ],
  "properties": {
    "date": {"type": "string", "format": "date"},
    "model_id": {"enum": ["M0", "M0_CC", "M1", "M2", "M3", "M4", "M5", "M6", "M7", "M8", "B_GICS_HS", "B_GICS_GAUSSIAN", "B_GICS_VINE", "B_HIER_HS", "B_HIER_GAUSSIAN", "B_HIER_VINE"]},
    "grouping_id": {"enum": ["none", "gics", "hierarchical", "spectral", "pca_kmeans", "gics_balanced", "hierarchical_balanced"]},
    "refit_id": {"type": "string", "minLength": 1},
    "var_95": {"type": "number"},
    "var_975": {"type": "number"},
    "var_99": {"type": "number"},
    "es_975": {"type": "number"},
    "realised_simple_return": {"type": "number"},
    "realised_loss": {"type": "number"},
    "seed_components": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "array",
          "prefixItems": [
            {"const": 5110},
            {"type": "integer", "minimum": 2020, "maximum": 2025},
            {"type": "integer", "minimum": 1, "maximum": 12}
          ],
          "minItems": 3,
          "maxItems": 3
        }
      ]
    },
    "margin_fallback_count": {"type": "integer", "minimum": 0},
    "whole_vine_fallback": {"type": "boolean"},
    "copula_log_score": {"type": ["number", "null"]},
    "forecast_status": {"enum": ["ok", "fallback", "failed"]}
  }
}
